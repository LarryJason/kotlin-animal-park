<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KotlinAnimalPark"
        tools:targetApi="31">

        <!-- Login = écran d’accueil -->
        <activity
            android:name=".ui.screens.Login"
            android:exported="true"
            android:label="@string/title_activity_login"
            android:theme="@style/Theme.KotlinAnimalPark" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Page principale avec la NavBar -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KotlinAnimalPark">
        </activity>

        <activity
            android:name=".ui.screens.TabView"
            android:exported="false"
            android:label="@string/title_activity_tab_view"
            android:theme="@style/Theme.KotlinAnimalPark" />
        <activity
            android:name=".ui.screens.User"
            android:exported="true"
            android:label="@string/title_activity_user"
            android:theme="@style/Theme.KotlinAnimalPark">
        </activity>
        <activity
            android:name=".ui.screens.Home"
            android:exported="true"
            android:label="@string/title_activity_home"
            android:theme="@style/Theme.KotlinAnimalPark">
        </activity>
        <activity
            android:name=".ui.screens.Register"
            android:exported="false"
            android:label="@string/title_activity_register"
            android:theme="@style/Theme.KotlinAnimalPark" />
        <activity
            android:name=".ui.screens.EnclosureDetails"
            android:exported="false"
            android:label="@string/title_activity_enclosure_details"
            android:theme="@style/Theme.KotlinAnimalPark"/>
    </application>

</manifest>